+/////////////////////////////////////////////////////////////////////////
+// WasmGridDisplay (shell-webgl.html)
+
+EM_JS(int, wwdos_js_wants_grid, (void), {
+    return Module.wwdosGrid ? 1 : 0;
+});
+
+// The page keeps the grid: ptr points at cols*rows*3 uint32 in wasm memory,
+// [codepoint | wide<<31, fg 0xRRGGBB, bg 0xRRGGBB] per cell. caretX/Y < 0 = hidden.
+EM_JS(void, wwdos_js_grid_flush, (uint32_t *ptr, int cols, int rows, int caretX, int caretY), {
+    if (Module.wwdosGrid)
+        Module.wwdosGrid(HEAPU32.subarray(ptr >> 2, (ptr >> 2) + cols * rows * 3), cols, rows, caretX, caretY);
+});
+
+namespace tvision
+{
+
+bool wasmWantsGrid() noexcept
+{
+    return wwdos_js_wants_grid() != 0;
+}
+
+namespace
+{
+
+std::vector<uint32_t> gridCells;
+TPoint gridSize {0, 0};
+TPoint gridCaret {-1, -1};
+int gridCaretSize = 0;
+bool gridDirty = false;
+
+// VGA/EGA 16-colour palette in BIOS order (black, blue, green, cyan, red, magenta, brown, grey, ...).
+constexpr uint32_t biosPalette[16] =
+{
+    0x000000, 0x0000AA, 0x00AA00, 0x00AAAA, 0xAA0000, 0xAA00AA, 0xAA5500, 0xAAAAAA,
+    0x555555, 0x5555FF, 0x55FF55, 0x55FFFF, 0xFF5555, 0xFF55FF, 0xFFFF55, 0xFFFFFF,
+};
+
+uint32_t xtermToRGB(uint8_t i) noexcept
+{
+    if (i < 16)
+        return biosPalette[TColorConversion::XTerm16toBIOS(i)];
+    if (i < 232)
+    {
+        i -= 16;
+        int r = i / 36, g = (i / 6) % 6, b = i % 6;
+        auto lv = [] (int v) -> uint32_t { return v ? 55 + 40 * v : 0; };
+        return (lv(r) << 16) | (lv(g) << 8) | lv(b);
+    }
+    uint32_t v = 8 + 10 * (i - 232);
+    return (v << 16) | (v << 8) | v;
+}
+
+uint32_t desiredToRGB(TColor c, bool fg) noexcept
+{
+    if (c.isRGB())
+    {
+        TColorRGB rgb = c.asRGB();
+        return (uint32_t(rgb.getRed()) << 16) | (uint32_t(rgb.getGreen()) << 8) | rgb.getBlue();
+    }
+    if (c.isBIOS())
+        return biosPalette[c.asBIOS() & 0xF];
+    if (c.isXTerm())
+        return xtermToRGB(c.asXTerm());
+    return fg ? 0xC0C0C0 : 0x000000;
+}
+
+uint32_t firstCodepoint(TStringView text) noexcept
+{
+    if (text.empty())
+        return ' ';
+    uint32_t u = 0;
+    size_t len = Utf8BytesLeft(text[0]) + 1;
+    if (len > text.size())
+        len = text.size();
+    uchar c = text[0];
+    if (len == 1) u = c;
+    else if (len == 2) u = c & 0x1F;
+    else if (len == 3) u = c & 0x0F;
+    else u = c & 0x07;
+    for (size_t i = 1; i < len; ++i)
+        u = (u << 6) | (uchar(text[i]) & 0x3F);
+    return u;
+}
+
+} // namespace
