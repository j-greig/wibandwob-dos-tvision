+// Browser console for Turbo Vision under Emscripten.
+//
+// Output: AnsiScreenWriter -> ConsoleCtl::write -> Module.wwdosWrite (xterm.js).
+// Input:  xterm.js onData bytes -> Module.wwdosPush -> a byte queue in JS,
+//         read here one byte at a time and parsed with TermIO (the same parser
+//         the Unix console uses for escape sequences and SGR mouse reports).
+// Size:   Module.wwdosCols/Rows; a page resize sets a flag that is turned into
+//         cmScreenChanged by WasmInput.
+// Waiting: EventWaiter::pollHandles (events.cpp) calls wasmWaitForInput(ms),
+//         an ASYNCIFY sleep that returns early when input arrives.
+
+#ifdef __EMSCRIPTEN__
+
+#define Uses_TKeys
+#define Uses_TEvent
+#define Uses_TPoint
+#include <tvision/tv.h>
+
+#include <internal/wasmcon.h>
+#include <internal/conctl.h>
+#include <internal/termio.h>
+#include <internal/ansiwrit.h>
+#include <internal/codepage.h>
+#include <internal/utf8.h>
+
+#include <emscripten.h>
+#include <vector>
+
+EM_JS(void, wwdos_js_write, (const char *data, size_t len), {
+    if (Module.wwdosWrite)
+        Module.wwdosWrite(HEAPU8.slice(data, data + len));
+});
+
+EM_JS(int, wwdos_js_cols, (void), {
+    return Module.wwdosCols ? Module.wwdosCols() : 80;
+});
+
+EM_JS(int, wwdos_js_rows, (void), {
+    return Module.wwdosRows ? Module.wwdosRows() : 25;
+});
+
+// Module.wwdosQueue is an array the page appends to; Module.wwdosPos is the
+// read index. Consumed bytes are dropped in bulk, never one shift() at a time.
+EM_JS(int, wwdos_js_getbyte, (void), {
+    var q = Module.wwdosQueue, p = Module.wwdosPos | 0;
+    if (!q || p >= q.length) return -1;
+    var b = q[p++];
+    if (p >= q.length) { q.length = 0; p = 0; }
+    else if (p > 4096) { q.splice(0, p); p = 0; }
+    Module.wwdosPos = p;
+    return b;
+});
+
+EM_JS(void, wwdos_js_ungetbyte, (int b), {
+    var q = Module.wwdosQueue = Module.wwdosQueue || [], p = Module.wwdosPos | 0;
+    if (p > 0) { q[--p] = b; Module.wwdosPos = p; }
+    else q.unshift(b);
+});
+
+EM_JS(int, wwdos_js_pending, (void), {
+    var q = Module.wwdosQueue;
+    return (q && (Module.wwdosPos | 0) < q.length) || Module.wwdosResized ? 1 : 0;
+});
+
+// Yield to the browser if C++ has run for more than 30 ms without waiting,
+// so a long burst of input (a big paste) cannot freeze painting and input.
+// Called only from event-polling code.
+EM_ASYNC_JS(void, wwdos_js_maybe_yield, (void), {
+    var now = performance.now();
+    if (now - (Module.wwdosLastYield || 0) < 30) return;
+    await new Promise(function (r) { setTimeout(r, 0); });
+    Module.wwdosLastYield = performance.now();
+});
+
+EM_JS(int, wwdos_js_take_resize, (void), {
+    if (Module.wwdosResized) { Module.wwdosResized = false; return 1; }
+    return 0;
+});
+
+EM_ASYNC_JS(void, wwdos_js_wait, (int ms), {
+    var q = Module.wwdosQueue;
+    if ((q && (Module.wwdosPos | 0) < q.length) || Module.wwdosResized) return;
+    await new Promise(function (resolve) {
+        var t = null;
+        var done = function () {
+            if (t !== null) clearTimeout(t);
+            Module.wwdosWake = null;
+            Module.wwdosLastYield = performance.now();
+            resolve();
+        };
+        Module.wwdosWake = done;
+        if (ms >= 0) t = setTimeout(done, ms);
+    });
+});
+
+namespace tvision
+{
+
+void wasmConsoleWrite(const char *data, size_t bytes) noexcept
+{
+    wwdos_js_write(data, bytes);
+}
+
+TPoint wasmConsoleSize() noexcept
+{
+    return {wwdos_js_cols(), wwdos_js_rows()};
+}
+
+bool wasmInputPending() noexcept
+{
+    return wwdos_js_pending() != 0;
+}
+
+void wasmWaitForInput(int ms) noexcept
+{
+    // A zero timeout is a non-blocking poll; never yield for it, or every
+    // getEvent() call would cost a trip through the browser event loop.
+#ifdef WWDOS_DEBUG_INPUT
+    EM_ASM({ console.log('wait', $0); }, ms);
+#endif
+    if (ms != 0)
+        wwdos_js_wait(ms);
+    else
+        wwdos_js_maybe_yield();
+}
+
