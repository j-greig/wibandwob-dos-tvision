+WasmGridDisplay::WasmGridDisplay(ConsoleCtl &aCon) noexcept :
+    con(aCon)
+{
+}
+
+TPoint WasmGridDisplay::reloadScreenInfo() noexcept
+{
+    gridSize = wasmConsoleSize();
+    gridCells.assign(size_t(gridSize.x) * gridSize.y * 3, 0);
+    gridDirty = true;
+    return gridSize;
+}
+
+int WasmGridDisplay::getColorCount() noexcept
+{
+    return 256*256*256;
+}
+
+TPoint WasmGridDisplay::getFontSize() noexcept
+{
+    return {8, 16};
+}
+
+void WasmGridDisplay::writeCell( TPoint pos, TStringView text, TColorAttr attr,
+                                 bool doubleWidth ) noexcept
+{
+    if (pos.x < 0 || pos.y < 0 || pos.x >= gridSize.x || pos.y >= gridSize.y)
+        return;
+    uint32_t fg = desiredToRGB(attr.getForeground(), true);
+    uint32_t bg = desiredToRGB(attr.getBackground(), false);
+    ushort style = attr.getStyle();
+    if (style & slReverse)
+    {
+        uint32_t t = fg; fg = bg; bg = t;
+    }
+    if (style & slUnderline)
+        fg |= 0x01000000;       // flag: page draws an underline row
+    size_t i = (size_t(pos.y) * gridSize.x + pos.x) * 3;
+    gridCells[i] = firstCodepoint(text) | (doubleWidth ? 0x80000000u : 0);
+    gridCells[i + 1] = fg;
+    gridCells[i + 2] = bg;
+    if (doubleWidth && pos.x + 1 < gridSize.x)
+    {
+        gridCells[i + 3] = 0x40000000u;     // trail: page draws the right half
+        gridCells[i + 4] = fg;
+        gridCells[i + 5] = bg;
+    }
+    gridDirty = true;
+}
+
+void WasmGridDisplay::setCaretPosition(TPoint pos) noexcept
+{
+    gridCaret = pos;
+    gridDirty = true;
+}
+
+void WasmGridDisplay::setCaretSize(int size) noexcept
+{
+    gridCaretSize = size;
+    gridDirty = true;
+}
+
+void WasmGridDisplay::clearScreen() noexcept
+{
+    for (size_t i = 0; i + 2 < gridCells.size(); i += 3)
+    {
+        gridCells[i] = ' ';
+        gridCells[i + 1] = 0xC0C0C0;
+        gridCells[i + 2] = 0;
+    }
+    gridDirty = true;
+}
+
+void WasmGridDisplay::flush() noexcept
+{
+    if (!gridDirty || gridCells.empty())
+        return;
+    gridDirty = false;
+    bool show = gridCaretSize > 0;
+    wwdos_js_grid_flush(gridCells.data(), gridSize.x, gridSize.y,
+                        show ? gridCaret.x : -1, show ? gridCaret.y : -1);
+}
+
