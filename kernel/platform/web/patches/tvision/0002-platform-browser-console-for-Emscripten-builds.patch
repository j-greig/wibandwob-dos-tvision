+static bool getEventImpl(WasmInputGetter &in, InputState &state, TEvent &ev) noexcept;
+
+bool WasmInput::getEvent(TEvent &ev) noexcept
+{
+    bool r = getEventImpl(in, state, ev);
+#ifdef WWDOS_DEBUG_INPUT
+    EM_ASM({ console.log('ev', $0, $1, $2.toString(16)); }, r, ev.what, ev.what == evKeyDown ? ev.keyDown.keyCode : 0);
+#endif
+    return r;
+}
+
+static bool getEventImpl(WasmInputGetter &in, InputState &state, TEvent &ev) noexcept
+{
+    if (wwdos_js_take_resize())
+    {
+        ev.what = evCommand;
+        ev.message.command = cmScreenChanged;
+        return true;
+    }
+
+    if (state.bracketedPaste)
+    {
+        int k = in.get();
+        if (k == -1)
+            return false;
+        if (k == '\x1B')
+        {
+            static const char end[] = "[201~";
+            int got[5], n = 0;
+            while (n < 5 && (got[n] = in.get()) == end[n])
+                ++n;
+            if (n == 5)
+            {
+                state.bracketedPaste = false;
+                return false;
+            }
+            // Not the delimiter: drop the ESC, keep the rest as pasted text.
+            if (got[n] != -1)
+                in.unget(got[n]);
+            while (n > 0)
+                in.unget(got[--n]);
+            return false;
+        }
+        in.unget(k);
+    }
+    else
+    {
+    GetChBuf buf(in);
+    switch (TermIO::parseEvent(buf, ev, state))
+    {
+        case Rejected: buf.reject(); break;
+        case Accepted: return true;
+        case Ignored: return false;
+    }
+    }
+
+    int k = in.get();
+    if (k == -1)
+        return false;
+
+    int keys[4] = {k};
+    int numKeys = 1;
+    bool alt = false;
+
+    ev.what = evKeyDown;
+    ev.keyDown = {};
+
+    if (k == '\x1B')
+    {
+        // ESC followed by another byte in the same burst is Alt+key.
+        int k2 = in.get();
+        if (k2 != -1)
+        {
+            keys[0] = k = k2;
+            alt = true;
+        }
+    }
+
+    if ((uint) k < 32)
+        ev.keyDown = fromNonPrintableAscii[k];
+    else if (k == 127)
+        ev.keyDown = {{kbBack}, 0};
+    else
+    {
+        numKeys += Utf8BytesLeft((char) k);
+        for (int i = 1; i < numKeys; ++i)
+        {
+            keys[i] = in.get();
+            if (keys[i] == -1 || (keys[i] & 0xC0) != 0x80)
+            {
+                if (keys[i] != -1)
+                    in.unget(keys[i]);
+                numKeys = i;
+                break;
+            }
+        }
+        for (int i = 0; i < numKeys; ++i)
+            ev.keyDown.text[i] = (char) keys[i];
+        ev.keyDown.textLength = (uchar) numKeys;
+        ev.keyDown.charScan.charCode = CpTranslator::fromUtf8({ev.keyDown.text, size_t(numKeys)});
+        if (ev.keyDown.keyCode <= kbCtrlZ)
+            ev.keyDown.keyCode = kbNoKey;
+    }
+
+    if (alt)
+    {
+        ev.keyDown.controlKeyState |= kbLeftAlt;
+        TermIO::normalizeKey(ev.keyDown);
+    }
+    if (state.bracketedPaste)
+        ev.keyDown.controlKeyState |= kbPaste;
+
+    return ev.keyDown.keyCode != kbNoKey || ev.keyDown.textLength;
+}
